      jakis_blad : Bool;
   END_VAR


BEGIN

END_DATA_BLOCK

DATA_BLOCK "cieplownia_dSTD"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
   VAR 
      Stan : Struct
         bezczynny : Bool;
         gotowy : Bool;
         pracuje : Bool;
         zatrzymanie : Bool;
         awaria : Bool;
         zezwolenie_na_prace : Bool;
         zatrzymano_wybiegiem : Bool;
      END_STRUCT;
      Symulacja : Bool;
   END_VAR


BEGIN
   Stan.bezczynny := true;
   Symulacja := false;

END_DATA_BLOCK

